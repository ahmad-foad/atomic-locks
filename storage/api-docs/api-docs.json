{
    "openapi": "3.0.0",
    "info": {
        "title": "Atomic Locks Demo API",
        "description": "Stops overselling the last ticket.\n\nThree ways to buy a ticket, with the same business logic: `/api/unsafe/...` has **no lock** (race condition), `/api/events/...` uses **Cache::lock** (atomic lock), `/api/row-lock/...` uses a PostgreSQL **row lock** (`DB::transaction` + `lockForUpdate`).\n\nStart with `POST /api/demo/reset` to create an event and get its `event_id`.",
        "version": "1.0.0"
    },
    "paths": {
        "/api/unsafe/events/{event}/buy": {
            "post": {
                "tags": [
                    "Tickets"
                ],
                "summary": "❌ BEFORE: buy a ticket with NO lock",
                "description": "Check-then-act with no lock. Many buyers at the same moment can all pass the check, so the last ticket is sold many times (stock goes below 0).",
                "operationId": "buyTicketUnsafe",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/EventId"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/BuyRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "$ref": "#/components/responses/Purchased"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "409": {
                        "$ref": "#/components/responses/SoldOut"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            }
        },
        "/api/events/{event}/buy": {
            "post": {
                "tags": [
                    "Tickets"
                ],
                "summary": "✅ AFTER: buy a ticket protected by Cache::lock",
                "description": "Only one request at a time holds the lock `event:{id}:tickets` (stored in the `cache_locks` table). Others wait up to 5 seconds, then get `503`.",
                "operationId": "buyTicket",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/EventId"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/BuyRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "$ref": "#/components/responses/Purchased"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "409": {
                        "$ref": "#/components/responses/SoldOut"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    },
                    "503": {
                        "description": "Waited too long for the lock",
                        "headers": {
                            "Retry-After": {
                                "description": "Seconds to wait before retrying",
                                "schema": {
                                    "type": "integer",
                                    "example": 1
                                }
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Message"
                                },
                                "example": {
                                    "message": "Too many buyers right now, please try again."
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/row-lock/events/{event}/buy": {
            "post": {
                "tags": [
                    "Tickets"
                ],
                "summary": "✅ ALTERNATIVE: buy a ticket protected by a PostgreSQL row lock",
                "description": "`DB::transaction` + `lockForUpdate()` runs `SELECT ... FOR UPDATE`: PostgreSQL locks the event row until COMMIT, so the other buyers wait and then read the real stock.",
                "operationId": "buyTicketRowLock",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/EventId"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/BuyRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "$ref": "#/components/responses/Purchased"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "409": {
                        "$ref": "#/components/responses/SoldOut"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            }
        },
        "/api/events/{event}": {
            "get": {
                "tags": [
                    "Tickets"
                ],
                "summary": "Stock and buyers of an event",
                "operationId": "showEvent",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/EventId"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Event stock",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "event": {
                                            "type": "string",
                                            "example": "Rock Concert - Front Row"
                                        },
                                        "tickets_left": {
                                            "type": "integer",
                                            "example": 0
                                        },
                                        "tickets_sold": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "buyers": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            },
                                            "example": [
                                                "Ali"
                                            ]
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    }
                }
            }
        },
        "/api/demo/reset": {
            "post": {
                "tags": [
                    "Demo"
                ],
                "summary": "Delete all orders and create a new event",
                "description": "Demo helper: start again with N tickets.",
                "operationId": "resetDemo",
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "tickets": {
                                        "type": "integer",
                                        "example": 1,
                                        "default": 1,
                                        "maximum": 1000,
                                        "minimum": 0
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "New event created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "event_id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "tickets_left": {
                                            "type": "integer",
                                            "example": 1
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "tickets is not a whole number between 0 and 1000",
                        "content": {
                            "application/json": {
                                "schema": {},
                                "example": {
                                    "message": "The tickets field must be at least 0.",
                                    "errors": {
                                        "tickets": [
                                            "The tickets field must be at least 0."
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "BuyRequest": {
                "required": [
                    "buyer"
                ],
                "properties": {
                    "buyer": {
                        "type": "string",
                        "example": "Ali",
                        "maxLength": 100
                    }
                },
                "type": "object"
            },
            "TicketPurchased": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Ticket purchased!"
                    },
                    "order_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "tickets_left": {
                        "type": "integer",
                        "example": 0
                    }
                },
                "type": "object"
            },
            "Message": {
                "properties": {
                    "message": {
                        "type": "string"
                    }
                },
                "type": "object"
            }
        },
        "responses": {
            "Purchased": {
                "description": "Ticket bought",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/TicketPurchased"
                        }
                    }
                }
            },
            "SoldOut": {
                "description": "No tickets left",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Message"
                        },
                        "example": {
                            "message": "Sold out."
                        }
                    }
                }
            },
            "NotFound": {
                "description": "Event not found (unknown or non-numeric id)",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Message"
                        },
                        "example": {
                            "message": "No query results for model [App\\Models\\Event] 99999"
                        }
                    }
                }
            },
            "ValidationError": {
                "description": "Validation error (buyer missing)",
                "content": {
                    "application/json": {
                        "schema": {},
                        "example": {
                            "message": "The buyer field is required.",
                            "errors": {
                                "buyer": [
                                    "The buyer field is required."
                                ]
                            }
                        }
                    }
                }
            }
        },
        "parameters": {
            "EventId": {
                "name": "event",
                "in": "path",
                "description": "Event id (from POST /api/demo/reset)",
                "required": true,
                "schema": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        }
    },
    "tags": [
        {
            "name": "Tickets",
            "description": "Buying tickets with and without a lock"
        },
        {
            "name": "Demo",
            "description": "Helpers for the live demo"
        }
    ]
}